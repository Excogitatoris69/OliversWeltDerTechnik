<Window x:Class="OtpMainGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OtpMainGui"
        xmlns:vm="clr-namespace:OtpMainGui.viewmodels"
        mc:Ignorable="d"
        Title="{Binding windowTitle}" 
        Top="{Binding windowTop}"
        Left="{Binding windowLeft}"
        Height="{Binding windowHeight}" 
        Width="{Binding windowWidth}"
        >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="350" />
            <RowDefinition Height="200" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" HorizontalAlignment="Left"   VerticalAlignment="Top" Width="400" Height="350">
            <TabItem Header="Logon">
                <Grid Background="#FFE5E5E5">
                    <StackPanel Orientation="Vertical" Margin="10,20,0,0">
                        <StackPanel Orientation="Horizontal"  Margin="10,5,0,0">
                            <Label Content="Username:" Width="80" />
                            <TextBox Text="{Binding username}"  Width="250" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="10,5,0,0">
                            <Label Content="Code:" Width="80" />
                            <TextBox Text="{Binding code}"  Width="100" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="10,10,0,0" >
                            <Button Content="Login" Click="Button_Click_Logon"  Width="80" Background="Green" Foreground="White" />
                        </StackPanel>

                    </StackPanel>

                </Grid>
            </TabItem>
            <TabItem Header="Register">
                <Grid Background="#FFE5E5E5">
                    <StackPanel Orientation="Vertical" Margin="10,20,0,0">
                        <StackPanel Orientation="Horizontal"  Margin="10,5,0,0">
                            <Label Content="Username:" Width="80" />
                            <TextBox Text="{Binding username}"  Width="250" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="10,5,0,0">
                            <Label Content="Password:" Width="80" />
                            <TextBox Text="{Binding password}"  Width="250" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="10,10,0,0">
                            <Button Content="Register" Click="Button_Click_Register" Margin="0,0,0,0" Width="80" Background="Green" Foreground="White" />
                            <Button Content="Clear" Click="Button_Click_ClearRegister" Margin="10,0,0,0" Width="80" Background="Yellow" Foreground="Black" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="10,20,10,10"  >
                            <Image Source="{Binding qrImageRegister}" Width="200" Height="200" />
                            <!-- 
                            -->
                        </StackPanel>
                    </StackPanel>

                </Grid>
            </TabItem>

            <TabItem Header="Show QR">
                <Grid Background="#FFE5E5E5">
                    <StackPanel Orientation="Vertical" Margin="10,20,0,0">
                        <StackPanel Orientation="Horizontal"  Margin="10,5,0,0">
                            <Label Content="Username:" Width="80" />
                            <TextBox Text="{Binding username}"  Width="250" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="10,5,0,0">
                            <Label Content="Password:" Width="80" />
                            <TextBox Text="{Binding password}"  Width="250" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Show" Click="Button_Click_Show"  Margin="10,0,0,0" Width="80" Background="Green" Foreground="White" />
                            <Button Content="Clear" Click="Button_Click_ClearShow" Margin="10,0,0,0" Width="80" Background="Yellow" Foreground="Black" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="20,20,0,0"  >
                            <Image Source="{Binding qrImageShow}" Width="200" Height="200" />
                            <!-- 
                             -->
                        </StackPanel>
                    </StackPanel>

                </Grid>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="1" Orientation="Vertical" Background="YellowGreen" Width="400" HorizontalAlignment="Left" >
            <Label Content="Code:" />
            <TextBlock Text="{Binding tbCode}" Margin="5,0,5,5" TextWrapping="NoWrap" Background="Yellow" />
            
        </StackPanel>
    </Grid>
</Window>
